    <!-- Setup checklist (spec §6.8) -->
    <string name="setup_title">Set up VoiceForm</string>
    <string name="setup_intro">Allow accessibility access to detect forms and interact with them when you ask.</string>
    <string name="setup_step1">1 · Enable accessibility service</string>
    <string name="setup_step1_hint">Opens system settings — returning here rechecks the status.</string>
    <string name="setup_step2">2 · Allow microphone permission</string>
    <string name="setup_step2_hint">Requested only when you choose — never at install.</string>
    <string name="setup_step3">3 · Check and continue</string>
    <string name="setup_check_accessibility">Accessibility</string>
    <string name="setup_check_microphone">Microphone</string>
