    <string name="setup_open_settings">Open Settings</string>
    <string name="setup_allow_mic">Allow microphone</string>
    <string name="setup_checking">Checking voice services…</string>
    <string name="setup_continue">Continue</string>
    <string name="setup_continue_voiceless">Continue without voice</string>
    <string name="setup_ready">VoiceForm is ready.</string>
    <string name="setup_learn_more">Learn more</string>
    <string name="setup_learning_body">VoiceForm uses accessibility access only to read the visible UI tree of the screen you are on, to find fields and act on them after you ask. Microphone audio goes to your configured Core for transcription; nothing is recorded at install, and passive screen reading never activates the mic.</string>
