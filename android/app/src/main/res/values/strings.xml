<resources>
    <string name="app_name">VoiceForm</string>
    <string name="accessibility_service_description">VoiceForm reads the current screen so you can fill forms by voice. It only processes the visible UI tree while you use the floating button — it does not collect keystrokes or network data on its own.</string>

